# Copia este archivo como .env y completa los valores.
# En PythonAnywhere también puedes definir estas variables en el panel Web > Environment variables.

FLASK_SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
ADMIN_PASSWORD=TuClaveAdminSegura

# Correo de envío (Gmail con contraseña de aplicación)
SMTP_EMAIL=analizamostunegocio@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Envío HTTPS (recomendado en PythonAnywhere free — SMTP suele estar bloqueado)
# 1) Despliega scripts/gmail_reto1_webhook.gs en script.google.com con la cuenta Gmail
# 2) Pega la URL de la app web aquí:
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=elige-un-secreto-largo

# Alternativa HTTPS (opcional): https://resend.com
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev

# Nombre visible en correos
MAIL_FROM_NAME=Misión Copilot 365 · ECCO

# URL pública de tu app (sin barra final).
# Cuenta PythonAnywhere: acatherinem
APP_BASE_URL=https://acatherinem.pythonanywhere.com
